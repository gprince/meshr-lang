// Plugin GCP Dataplex - Annotations pour l'intégration Dataplex Universal Catalog
// Version 1.0.0

@Version("1.0.0")
@Documented(summary="Annotations pour l'intégration Dataplex Universal Catalog")
module stdlib.plugins.gcp.dataplex.annotations

// Import des annotations de base
import { Version, Documented } from meshr.core

@since("1.0.0")
@id("dataplex-aspect-annotation")
@description("Annotation pour déclarer un type d'aspect compatible avec Dataplex Universal Catalog")
annotation DataplexAspect is
    required aspect_type_id : String
    optional display_name : String = "Default Aspect"
    optional description : String = "Default aspect description"
    optional labels : Map of String to String = Map{}
end

@since("1.0.0")
@id("dataplex-enum-annotation")
@description("Annotation pour déclarer un enum compatible avec Dataplex Universal Catalog")
annotation DataplexEnum is
    required enum_type : String
    optional description : String = "Default enum description"
end

@since("1.0.0")
@id("dataplex-entry-annotation")
@description("Annotation pour déclarer une entrée compatible avec Dataplex Universal Catalog")
annotation DataplexEntry is
    required entry_id : String
    required entry_type : String
    optional display_name : String = "Default Entry"
    optional description : String = "Default entry description"
    optional labels : Map of String to String = Map{}
end

// ========== MÉTA-ANNOTATIONS POUR LE VERSIONING ==========

@since("1.0.0")
@id("since-annotation")
@description("Indique depuis quelle version cette déclaration est disponible")
annotation since is
    required version : String
end

@since("1.0.0")
@id("id-annotation")
@description("Identifiant unique pour cette déclaration")
annotation id is
    required identifier : String
end

@since("1.0.0")
@id("display-name-annotation")
@description("Nom d'affichage pour cette déclaration")
annotation display_name is
    required name : String
end

@since("1.0.0")
@id("description-annotation")
@description("Description détaillée de cette déclaration")
annotation description is
    required text : String
end

export {
  DataplexAspect,
  DataplexEnum, 
  DataplexEntry,
  since,
  id,
  display_name,
  description
}
