// ==============================
// Exemple simple d'utilisation de la StdLib
// ==============================
// Démonstration d'une entité Customer simple
// sans références aux modules de la stdlib

module examples.simple_customer

export { Customer }

// ========== ENUMS ==========

enum CustomerStatus is (
  "active",
  "inactive", 
  "suspended"
)

// ========== ASPECTS ==========

aspect CustomerData is
  created_at : Timestamp
  updated_at : Timestamp
  status : CustomerStatus
  last_login : Timestamp
end

// ========== ENTITÉ CUSTOMER ==========

entity Customer is
  customer_id : String
  email : String
  first_name : String
  last_name : String
  phone : String
  birth_date : Date
  address : String
  
  aspects {
    CustomerData {
      created_at: "2024-01-01T00:00:00Z",
      updated_at: "2024-01-01T00:00:00Z",
      status: "active",
      last_login: "2024-01-01T00:00:00Z"
    }
  }
end
