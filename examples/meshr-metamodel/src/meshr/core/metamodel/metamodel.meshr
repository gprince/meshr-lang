enum OwnershipRole is ("primary", "delegated", "custodian", "observer")

@Since("1.0.0")
type relation HawOwnerRelationType is
  ownershipSince : Date           // Date à laquelle l'entité est devenue propriétaire
  ownershipRole : OwnershipRole   // Rôle du propriétaire (ex: primary, delegated)
  ownershipShare : Float = 1.0    // Part de propriété comprise entre 0.0 et 1.0
end

relation DoaminOwnerRelation of type has_owner is
  from Domain(domain_id)
  to Owner(owner_id)




