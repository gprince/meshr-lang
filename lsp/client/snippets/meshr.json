{
  "Module Declaration": {
    "prefix": "module",
    "body": [
      "module ${1:com.example.module};",
      "",
      "${2:// Contenu du module}"
    ],
    "description": "Déclaration de module"
  },
  "Import Statement": {
    "prefix": "import",
    "body": [
      "import ${1:com.example.module};"
    ],
    "description": "Import d'un module"
  },
  "Entity Declaration": {
    "prefix": "entity",
    "body": [
      "entity ${1:EntityName} {",
      "    ${2:// Champs de l'entité}",
      "}"
    ],
    "description": "Déclaration d'entité"
  },
  "Entity with Fields": {
    "prefix": "entity-fields",
    "body": [
      "entity ${1:EntityName} {",
      "    ${2:String} ${3:fieldName} = ${4:\"default\"};",
      "    ${5:Number} ${6:anotherField};",
      "}"
    ],
    "description": "Entité avec des champs"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName} {",
      "    ${2:VALUE1},",
      "    ${3:VALUE2}",
      "}"
    ],
    "description": "Déclaration d'énumération"
  },
  "Trait Declaration": {
    "prefix": "trait",
    "body": [
      "trait ${1:TraitName} {",
      "    ${2:// Définition du trait}",
      "}"
    ],
    "description": "Déclaration de trait"
  },
  "Aspect Declaration": {
    "prefix": "aspect",
    "body": [
      "aspect ${1:AspectName} {",
      "    ${2:// Définition de l'aspect}",
      "}"
    ],
    "description": "Déclaration d'aspect"
  },
  "Annotated Entity": {
    "prefix": "entity-annotated",
    "body": [
      "@${1:Documented}",
      "entity ${2:EntityName} {",
      "    ${3:// Champs de l'entité}",
      "}"
    ],
    "description": "Entité avec annotation"
  },
  "List Type": {
    "prefix": "list",
    "body": [
      "List of ${1:String}"
    ],
    "description": "Type List"
  },
  "Map Type": {
    "prefix": "map",
    "body": [
      "Map of ${1:String} to ${2:String}"
    ],
    "description": "Type Map"
  },
  "Bytes Literal": {
    "prefix": "bytes",
    "body": [
      "Bytes[${1:0, 1, 2, 3}]"
    ],
    "description": "Littéral Bytes"
  },
  "JSON Literal": {
    "prefix": "json",
    "body": [
      "Json{\"${1:key}\": \"${2:value}\"}"
    ],
    "description": "Littéral JSON"
  },
  "Geography Literal": {
    "prefix": "geo",
    "body": [
      "Geography{\"${1:POINT(2.3522 48.8566)}\"}"
    ],
    "description": "Littéral Geography"
  },
  "Comment Block": {
    "prefix": "comment",
    "body": [
      "/*",
      " * ${1:Commentaire}",
      " */"
    ],
    "description": "Bloc de commentaire"
  },
  "TODO Comment": {
    "prefix": "todo",
    "body": [
      "// TODO: ${1:Description de la tâche}"
    ],
    "description": "Commentaire TODO"
  },
  "Metric Declaration": {
    "prefix": "metric",
    "body": [
      "metric ${1:MetricName} is",
      "  source ${2:EntityName}",
      "  calculation ${3:avg(field_name)}",
      "  unit \"${4:EUR}\"",
      "end"
    ],
    "description": "Déclaration de métrique simple"
  },
  "Metric with Dimensions": {
    "prefix": "metric-dimensions",
    "body": [
      "metric ${1:MetricName} is",
      "  source ${2:EntityName}",
      "  calculation ${3:sum(field_name)}",
      "  unit \"${4:EUR}\"",
      "  ",
      "  dimensions {",
      "    ${5:dimension_name} ${6:field_name}",
      "  }",
      "end"
    ],
    "description": "Métrique avec dimensions"
  },
  "Metric with Pattern Matching": {
    "prefix": "metric-pattern",
    "body": [
      "metric ${1:MetricName} is",
      "  source ${2:EntityName}",
      "  calculation ${3:avg(field_name)}",
      "  unit \"${4:days}\"",
      "  ",
      "  dimensions {",
      "    ${5:category} match ${6:field_name} is",
      "      ${7:EnumType}.${8:value1} -> \"${9:result1}\",",
      "      ${10:EnumType}.${11:value2} -> \"${12:result2}\",",
      "      _ -> \"${13:other}\"",
      "    end",
      "  }",
      "end"
    ],
    "description": "Métrique avec pattern matching"
  },
  "Metric Complete": {
    "prefix": "metric-complete",
    "body": [
      "@${1:BusinessCritical}(impact=\"high\")",
      "metric ${2:MetricName} is",
      "  source ${3:EntityName}",
      "  calculation ${4:avg(field_name)}",
      "  unit \"${5:EUR}\"",
      "  ",
      "  outputs {",
      "    ${6:result_value} : ${7:Float},",
      "    calculation_timestamp : Timestamp",
      "  }",
      "  ",
      "  dimensions {",
      "    ${8:dimension_name} ${9:field_name}",
      "  }",
      "  ",
      "  filters {",
      "    ${10:status} == ${11:EnumType}.${12:value}",
      "  }",
      "  ",
      "  aspects {",
      "    MetricGovernance {",
      "      business_owner: \"${13:owner@company.com}\"",
      "    }",
      "  }",
      "end"
    ],
    "description": "Métrique complète avec tous les éléments"
  }
}
