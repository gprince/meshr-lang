module demo.invalid_string_constraints

// ========== ANNOTATION avec contraintes String invalides ==========
annotation BadUserProfile is
  required email : String pattern "^[^@]+@[^@]+$" pattern "^[a-z]+$"  // Double pattern
  required username : String length 3..20 length 5..15               // Double length
  optional phone : String pattern "^[0-9]{10,15}$" length 5..10      // Length incompatible avec pattern
  optional bio : String length 20..10                                 // Min > Max
  optional invalid : String pattern "invalid[regex"                  // Regex invalide (crochet non fermé)
end

// ========== ENUM avec contraintes String invalides ==========
enum BadStatus(value: String, description: String) is (
  active(value = "active", description = "System is operational"),
  maintenance(value = "maintenance", description = "System under maintenance"),
  error(value = "error", description = "System error occurred")
)

enum BadHttpStatus(code: Integer, message: String pattern "^[A-Z][a-z ]+$") is (
  ok(code = 200, message = "OK"),
  not_found(code = 404, message = "not found"),                      // Ne respecte pas le pattern (minuscule)
  internal_error(code = 500, message = "Internal Server Error")
)

// ========== RECORD avec contraintes String invalides ==========
record BadContact is
  name : String length 1..100
  email : String pattern "^[^@]+@[^@]+$"
  phone : String pattern "^[0-9]{10,15}$" length 5..10               // Length incompatible
  website : String pattern "^https?://.*" length 200..7              // Min > Max
end

record BadAddress is
  street : String length 1..200
  city : String length 1..100
  postalCode : String pattern "^[0-9]{5}(-[0-9]{4})?$"
  country : String length 2..3
end

// ========== TRAIT avec contraintes String invalides ==========
trait BadIdentifiable is
  id : String pattern "^[a-zA-Z0-9_-]+$" length 1..50
  name : String length 1..100
end

trait BadContactable is
  email : String pattern "^[^@]+@[^@]+$"
  phone : String pattern "^[0-9]{10,15}$"
end

trait BadTimestamped is
  createdAt : String pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  updatedAt : String pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
end

// ========== RECORD avec TRAITS invalides (composition) ==========
record BadUser with BadIdentifiable, BadContactable, BadTimestamped is
  role : String pattern "^(admin|user|guest)$"
  status : String pattern "^(active|inactive|suspended)$"
end

 ========== ANNOTATION avec contraintes complexes invalides ==========
 Exemple d'utilisation de l'annotation BadUserProfile (qui devrait échouer) :
 @BadUserProfile(
   email = "user@example.com",
   username = "johndoe",
   phone = "1234567890",
   bio = "Software developer with 5 years experience"
 )
